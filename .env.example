NODE_ENV=development
PORT=3000

# Use a long random value. Required in every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=5432
DB_NAME=boilerplate
DB_USER=postgres
DB_PASSWORD=

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BODY_LIMIT=1mb
CORS_ORIGIN=*
# Ejemplo: CORS_ORIGIN=https://app.example.com,https://admin.example.com
